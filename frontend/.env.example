# SIH 2026 Integrated Mine Safety Monitoring System
# Frontend Environment Configuration Template

# Backend REST API Base URL (Prefix)
# In development with Vite proxy, use /api/v1 (requests forward to backend port 8000).
# In production or standalone mode, point directly to the backend URL, e.g. http://localhost:8000/api/v1
VITE_API_BASE_URL=/api/v1

# HTTP Request Timeout in Milliseconds (Default: 10000ms / 10s)
VITE_API_TIMEOUT_MS=10000

# WebSocket Base URL for Live Telemetry
VITE_WS_BASE_URL=ws://localhost:8000/api/v1/ws/telemetry

# Development-only mock data fallback toggle (Strictly false by default)
# When false: offline backend shows genuine error/loading/empty states, no silent mock data.
# When true: development-only fallback with visible disclaimer badges.
VITE_ENABLE_MOCK_FALLBACK=false
