# Application Configuration
APP_NAME="Integrated Mine Safety Monitoring System Backend"
APP_ENV="development"
DEBUG=true
API_PREFIX="/api/v1"
LOG_LEVEL="INFO"

# Database Configuration (Phase 2 Baseline)
# Primary Production Target: PostgreSQL
# Example PostgreSQL URL: postgresql+psycopg://postgres:password@localhost:5432/mine_safety
# Local / Test Fallback: SQLite
DATABASE_URL="sqlite+aiosqlite:///./mine_safety.db"
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_S=1800

# Live Monitoring WebSocket Configuration (Phase 5)
WS_KEEPALIVE_INTERVAL_S=30
WS_MAX_QUEUE_SIZE=50

# Risk & Alert Engine Configuration (Phase 6)
NODE_UNRESPONSIVE_TIMEOUT_S=60

# AI / Anomaly Detection Configuration (Phase 7)
AI_ANOMALY_ZSCORE_THRESHOLD=3.0
AI_BASELINE_WINDOW_SIZE=30
AI_MIN_SAMPLES_FOR_INFERENCE=5

# Security & Reliability Configuration (Phase 9)
# Comma-separated or JSON list of allowed origins
CORS_ALLOWED_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
MAX_TELEMETRY_READINGS_PER_REQUEST=500
RATE_LIMIT_ENABLED=false
RATE_LIMIT_PER_MINUTE=600
